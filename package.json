{
  "name": "thc-integrated-software",
  "version": "0.1.0",
  "private": true,
  "description": "Production, ordering and bookkeeping for The Happy Cookie.",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=phone --project=desktop --project=webkit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "verify:port": "node scripts/check-port-integrity.mjs",
    "verify:port:update": "node scripts/check-port-integrity.mjs --update",
    "db:seed:gen": "node scripts/gen-seed.mjs",
    "typecheck:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "verify": "pnpm verify:port && pnpm typecheck && pnpm typecheck:e2e && pnpm lint && pnpm test"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.115.0",
    "zod": "4.6.6",
    "@sentry/nextjs": "10.75.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "sharp@<0.35.5": "0.35.5",
      "tmp@<0.2.7": "0.2.7",
      "image-size@>=0.6.3 <=2.0.2": "2.0.3",
      "source-map-js@<1.2.2": "1.2.2",
      "compression@<1.8.2": "1.8.2",
      "proxy-addr@<2.0.8": "2.0.8",
      "webpack-dev-middleware@<7.4.6": "7.4.6",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "glob@>=13.0.0 <14.0.2": "14.0.2",
      "@opentelemetry/api@>=1.9.0 <1.11.0": "1.9.0",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "brace-expansion@<1.1.21": "1.1.21",
      "basic-ftp@<=6.2.3": "6.2.4",
      "qs@>=6.7.0 <6.16.1": "6.16.1",
      "minimatch@>=7.0.0 <11.0.1": "11.0.5",
      "uuid@<11.1.1": "11.1.1",
      "@vitest/mocker@<4.1.12": "4.1.12",
      "vite": "7.3.7",
      "ip-address@<=10.7.3": "10.7.4"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "core-js-pure",
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  }
}
